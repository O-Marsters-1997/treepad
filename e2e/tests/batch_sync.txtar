tp-init-repo

exec sh -c 'printf "[from_spec]\nticket_url = \"https://linear.app/acme/issue/{{.Ref}}\"\n" > .treepad.toml'

exec sh -c 'mkdir -p .git/treepad/batches'
exec sh -c 'printf "name = \"silent-refresh\"\nbranch_prefix = \"feat/\"\nbase = \"main\"\n\n[[chain]]\ntickets = [\"ENG-12\", \"ENG-13\"]\n\n[[chain]]\ntickets = [\"ENG-14\"]\n" > .git/treepad/batches/silent-refresh.toml'

# --dry-run touches nothing; without gh, only Chain heads would be created
exec tp batch sync --dry-run
stdout 'would-create'
stdout 'gh-required'
! exists ../repo-feat-eng-12
! exists ../repo-feat-eng-13
! exists ../repo-feat-eng-14

exec tp batch sync --dry-run --json
stdout '"action":"would-create"'
stdout '"action":"gh-required"'
! exists ../repo-feat-eng-12

# the real run materialises Chain heads only: gh is unavailable in this
# sandbox (HOME is redirected), so feat/eng-13 reports gh-required and no
# worktree is created for it
exec tp batch sync --json
stdout '"action":"created"'
stdout '"branch":"feat/eng-12"'
stdout '"branch":"feat/eng-14"'
stdout '"action":"gh-required"'
stdout '"branch":"feat/eng-13"'
exists ../repo-feat-eng-12
! exists ../repo-feat-eng-13
exists ../repo-feat-eng-14

# re-running is idempotent: creates nothing more and exits 0
exec tp batch sync --json
stdout '"action":"skipped"'
! stdout '"action":"created"'

# --batch narrows to one Manifest
exec sh -c 'printf "name = \"other\"\n\n[[chain]]\ntickets = [\"ENG-99\"]\n" > .git/treepad/batches/other.toml'

exec tp batch sync --batch silent-refresh --json
! stdout '"ticket":"ENG-99"'
! exists ../repo-feat-eng-99

exec tp batch sync --batch other --json
stdout '"ticket":"ENG-99"'
exists ../repo-feat-eng-99

# --offline skips gh entirely and still exits 0, marking PR state stale
exec tp batch sync --offline --json
stdout '"pr_stale":true'

! stdout '__TREEPAD_CD__'
