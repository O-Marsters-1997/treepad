tp-init-repo

exec sh -c 'printf "[from_spec]\nagent_command = []\nticket_url = \"https://linear.app/acme/issue/{{.Ref}}\"\n" > .treepad.toml'

# Mixes a bare ref, a GitHub URL, and a Linear URL with a title slug in one invocation.
exec tp from-spec-bulk --tickets 'ENG-123,https://github.com/acme/widgets/issues/42,https://linear.app/acme/issue/ENG-99/silent-refresh' --branch-prefix feat/

exists ../repo-feat-eng-123/PROMPT.md
grep 'https://linear.app/acme/issue/ENG-123' ../repo-feat-eng-123/PROMPT.md

exists ../repo-feat-42/PROMPT.md
grep 'https://github.com/acme/widgets/issues/42' ../repo-feat-42/PROMPT.md

exists ../repo-feat-silent-refresh/PROMPT.md
grep 'https://linear.app/acme/issue/ENG-99/silent-refresh' ../repo-feat-silent-refresh/PROMPT.md

stderr '3 succeeded, 0 failed'

# No gh dependency, and no shell cd directive for a multi-worktree command.
! stdout '__TREEPAD_CD__'
