tp-init-repo

exec sh -c 'printf "[from_spec]\nagent_command = []\nticket_url = \"https://linear.app/acme/issue/{{.Ref}}\"\n" > .treepad.toml'

# A full Ticket URL is cited verbatim, regardless of ticket_url.
exec tp from-spec feat-url --ticket https://github.com/acme/widgets/issues/42 --current
exists ../repo-feat-url/PROMPT.md
grep 'https://github.com/acme/widgets/issues/42' ../repo-feat-url/PROMPT.md

# A bare Ref is rendered through ticket_url.
exec tp from-spec feat-ref --ticket ENG-123 --current
exists ../repo-feat-ref/PROMPT.md
grep 'https://linear.app/acme/issue/ENG-123' ../repo-feat-ref/PROMPT.md
